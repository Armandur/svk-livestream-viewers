# Kommaseparerad lista med UUID:namn-par för strömmar att bevaka.
# UUID hittas i Rackfish player-URL:en eller via SVK admin-API:et.
# Exempel: c9edf4b1-d693-11e7-a385-005056be0018:svk005
STREAM_UUIDS=uuid1:svk005,uuid2:svk007

# Port som servern lyssnar på
PORT=8765

# Loggnivå (DEBUG visar råvärde/justerat/visat per event)
LOG_LEVEL=INFO
